<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title><%= seo.title %></title>
<meta name="description" content="<%= seo.description %>" />

<!-- Open Graph / WhatsApp preview -->
<meta property="og:type" content="website" />
<meta property="og:title" content="<%= seo.title %>" />
<meta property="og:description" content="<%= seo.description %>" />
<meta property="og:image" content="<%= seo.ogImage %>" />
<meta name="theme-color" content="#10251f" />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Petit+Formal+Script&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- LOADING SCREEN -->
<div id="loader" aria-hidden="true">
  <div class="mono">M &amp; L</div>
  <div class="loader-line"></div>
</div>

<!-- NAVIGATION -->
<nav class="nav" id="nav">
  <div class="nav__mark">M&nbsp;|&nbsp;L</div>
  <div class="nav__links">
    <a href="#hero">Home</a>
    <a href="#couple">Our Story</a>
    <a href="#details">Details</a>
    <a href="#venue">Venue</a>
    <a href="#rsvp">RSVP</a>
    <a href="#contact">Contact</a>
  </div>
  <button class="nav__toggle" id="navToggle" aria-label="Open menu" aria-expanded="false">
    <span></span>
  </button>
</nav>

<!-- MOBILE MENU -->
<div class="mnav" id="mnav">
  <button class="mnav__close" id="mnavClose" aria-label="Close menu">&times;</button>
  <ul class="mnav__list">
    <li style="--i:0"><a href="#hero">Home</a></li>
    <li style="--i:1"><a href="#couple">Our Story</a></li>
    <li style="--i:2"><a href="#details">Details</a></li>
    <li style="--i:3"><a href="#venue">Venue</a></li>
    <li style="--i:4"><a href="#rsvp">RSVP</a></li>
    <li style="--i:5"><a href="#contact">Contact</a></li>
  </ul>
</div>

<!-- 1. HERO -->
<section class="hero" id="hero">
  <div class="hero__media" id="heroMedia">
    <div class="hero__fallback"></div>
    <img
      class="hero__photo"
      id="heroPhoto"
      data-src="<%= hero.image %>"
      data-position-mobile="<%= hero.positionMobile %>"
      data-position-desktop="<%= hero.positionDesktop %>"
      alt="<%= couple.groom %> and <%= couple.bride %>"
    />
  </div>
  <div class="hero__overlay"></div>
  <div class="hero__particles" id="heroParticles" aria-hidden="true"></div>

  <div class="hero__content">
    <p class="hero__names" id="heroNames">
      <%= couple.groom %>
      <span class="hero__amp">&amp;</span>
      <%= couple.bride %>
    </p>
    <p class="hero__subtitle">— Wedding Invitation —</p>
    <svg class="hero__ornament ornament" viewBox="0 0 48 28" fill="none">
      <path d="M2 20C10 4 18 4 24 14C30 4 38 4 46 20" stroke-width="1"/>
      <circle cx="24" cy="22" r="2" stroke-width="1"/>
    </svg>
    <p class="hero__date"><%= date %></p>

    <div class="hero__scroll" id="heroScroll" aria-hidden="true">
      <span class="pill"></span>
    </div>
  </div>
</section>

<!-- 2. COUPLE -->
<section class="section section--ivory" id="couple">
  <div class="section__head reveal">
    <p class="eyebrow">The Couple</p>
    <h2 class="section__title h-serif">Two Paths, One Journey</h2>
    <p class="section__sub">A kind heart and a gentle soul, coming together as one.</p>
  </div>

  <div class="couple__wrap">
    <div class="couple__cards">
      <div class="couple__card reveal-scale">
        <p class="couple__role">Groom</p>
        <p class="couple__name"><%= couple.groom %></p>
        <p class="couple__line">A kind heart, a bright future</p>
      </div>
      <span class="couple__amp reveal-scale">&amp;</span>
      <div class="couple__card reveal-scale">
        <p class="couple__role">Bride</p>
        <p class="couple__name"><%= couple.bride %></p>
        <p class="couple__line">A beautiful soul, a greater tomorrow</p>
      </div>
    </div>
  </div>
</section>

<!-- 3. INVITATION MESSAGE -->
<section class="section section--emerald" id="invite">
  <div class="invite__card reveal-scale">
    <p class="eyebrow">A Special Invitation</p>
    <div class="divider reveal-line"></div>
    <p class="invite__text" style="color:var(--ivory);">
      With hearts full of joy, we invite you to be a part of our special day.
      Your presence will make our celebration even more meaningful.
    </p>
  </div>
</section>

<!-- 4. WEDDING DETAILS -->
<section class="section section--ivory" id="details">
  <div class="section__head reveal">
    <p class="eyebrow">The Big Day</p>
    <h2 class="section__title h-serif">A Day To Remember</h2>
    <p class="section__sub">A day filled with love, tradition and new beginnings.</p>
  </div>

  <div class="details__grid stagger">
    <div class="details__card reveal" style="--i:0">
      <svg class="details__icon ornament" viewBox="0 0 40 40" fill="none"><rect x="7" y="10" width="26" height="23" rx="1" stroke-width="1"/><path d="M7 17H33" stroke-width="1"/><path d="M13 6V12" stroke-width="1" stroke-linecap="round"/><path d="M27 6V12" stroke-width="1" stroke-linecap="round"/></svg>
      <p class="details__label">Date</p>
      <p class="details__big"><%= date %></p>
    </div>
    <div class="details__card reveal" style="--i:1">
      <svg class="details__icon ornament" viewBox="0 0 40 40" fill="none"><path d="M20 6C13 12 12 18 20 24C28 18 27 12 20 6Z" stroke-width="1"/><path d="M20 24V33" stroke-width="1" stroke-linecap="round"/><path d="M13 33H27" stroke-width="1" stroke-linecap="round"/></svg>
      <p class="details__label">Muhurtham</p>
      <p class="details__big"><%= muhurtham.date %><br/><%= muhurtham.time %></p>
    </div>
    <div class="details__card reveal" style="--i:2">
      <svg class="details__icon ornament" viewBox="0 0 40 40" fill="none"><path d="M13 6V19C13 21 15 22 15 22V34" stroke-width="1" stroke-linecap="round"/><path d="M9 6V16C9 18 13 18 13 16V6" stroke-width="1" stroke-linecap="round"/><path d="M27 6C24 6 24 12 24 15C24 18 27 19 27 19V34" stroke-width="1" stroke-linecap="round"/></svg>
      <p class="details__label">Dinner</p>
      <p class="details__big"><%= dinner %></p>
    </div>
  </div>
</section>

<!-- 5. VENUE -->
<section class="section section--emerald" id="venue">
  <div class="venue__parallax" id="venueParallax"></div>
  <div class="section__head reveal">
    <p class="eyebrow">Venue</p>
    <h2 class="section__title h-serif">Where We Celebrate</h2>
    <p class="section__sub">Our happiness multiplies with your presence.</p>
  </div>

  <div class="venue__frame reveal-scale">
    <svg class="venue__arch ornament" viewBox="0 0 120 70" fill="none">
      <path d="M6 68V34C6 16 24 6 44 6H76C96 6 114 16 114 34V68" stroke-width="1"/>
      <path d="M18 68V38C18 24 30 16 44 16H76C90 16 102 24 102 38V68" stroke-width="1"/>
    </svg>
    <p class="venue__name script" style="font-family:var(--font-script); font-size:32px;"><%= venue.name %></p>
    <p class="venue__addr"><%= venue.address %></p>
    <a class="btn btn--outline venue__btn" href="<%= mapsUrl %>" target="_blank" rel="noopener">Get Directions</a>
  </div>
</section>

<!-- 6. RSVP -->
<section class="section section--ivory" id="rsvp">
  <div class="section__head reveal">
    <p class="eyebrow">Kindly RSVP</p>
    <h2 class="section__title h-serif">Save Your Seat</h2>
    <p class="section__sub">Your response helps us plan better for a memorable celebration.</p>
  </div>

  <div class="rsvp__card reveal-scale">
    <form id="rsvpForm" novalidate>
      <div class="field">
        <label for="rsvpName">Your Name</label>
        <input type="text" id="rsvpName" name="name" required autocomplete="name" />
      </div>

      <div class="field">
        <label>Attendance</label>
        <div class="attend">
          <label><input type="radio" name="attendance" value="attending" checked /> I will be attending</label>
          <label><input type="radio" name="attendance" value="not-attending" /> I will not be attending</label>
        </div>
      </div>

      <div class="field">
        <label>Number of Guests</label>
        <div class="qty">
          <button type="button" id="qtyMinus" aria-label="Decrease guests">&minus;</button>
          <span id="qtyValue">1</span>
          <button type="button" id="qtyPlus" aria-label="Increase guests">+</button>
        </div>
      </div>

      <div class="field">
        <label for="rsvpMsg">Your Message (Optional)</label>
        <textarea id="rsvpMsg" name="message"></textarea>
      </div>

      <button type="submit" class="btn btn--gold rsvp__submit" id="rsvpSubmit">Send RSVP</button>
      <p class="rsvp__error" id="rsvpError">Something went wrong. Please try again.</p>
      <p class="rsvp__note" id="rsvpNote">Your presence means a lot to us.</p>
    </form>

    <div class="rsvp__success" id="rsvpSuccess">
      <div class="ring">
        <svg viewBox="0 0 24 24" fill="none"><path d="M4 12L10 18L20 6" stroke="var(--gold)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h3 class="h-serif">Thank You</h3>
      <p>Your response has been received.</p>
    </div>
  </div>
</section>

<!-- 7. CONTACT -->
<section class="section section--emerald" id="contact">
  <div class="section__head reveal">
    <p class="eyebrow">Get In Touch</p>
    <h2 class="section__title h-serif">We're Happy To Help</h2>
    <p class="section__sub">For any queries, feel free to reach us.</p>
  </div>
  <div class="contact__list stagger">
    <% contacts.forEach(function(num, i){ %>
      <a href="tel:<%= num.replace(/\s+/g,'') %>" style="--i:<%= i %>">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 3h3l2 5-2.5 2a12 12 0 0 0 6.5 6.5l2-2.5 5 2v3a2 2 0 0 1-2 2C10.5 21 3 13.5 3 5a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.3"/></svg>
        <span><%= num %></span>
      </a>
    <% }); %>
  </div>
</section>

<!-- 8. CLOSING -->
<section class="closing" id="closing">
  <p class="closing__names script reveal-scale">
    <%= couple.groom %>
    <span class="closing__amp">&amp;</span>
    <%= couple.bride %>
  </p>
  <p class="closing__msg reveal">Together Today,<br/>Forever Always</p>
  <p class="closing__see reveal">See You At The Wedding</p>
  <svg class="closing__heart ornament reveal" viewBox="0 0 24 24" fill="none"><path d="M12 20C12 20 3 14.5 3 8.5C3 5.5 5.5 3.5 8 3.5C10 3.5 11.5 4.5 12 6C12.5 4.5 14 3.5 16 3.5C18.5 3.5 21 5.5 21 8.5C21 14.5 12 20 12 20Z" stroke="var(--gold)" stroke-width="1"/></svg>
</section>

<footer class="footer"><%= couple.groom %> &amp; <%= couple.bride %></footer>
<div class="credit">
  <p>Invitation design by <a href="https://www.instagram.com/<%= credit.instagram %>" target="_blank" rel="noopener">@<%= credit.instagram %></a> — <a href="mailto:<%= credit.email %>"><%= credit.email %></a></p>
</div>

<button class="music-toggle" id="musicToggle" hidden aria-label="Toggle music">
  <svg viewBox="0 0 24 24" width="16" height="16" fill="none"><path d="M9 18V6l10-2v12" stroke="currentColor" stroke-width="1.4"/><circle cx="6.5" cy="18" r="2.5" stroke="currentColor" stroke-width="1.4"/><circle cx="16.5" cy="16" r="2.5" stroke="currentColor" stroke-width="1.4"/></svg>
</button>
<audio id="bgAudio" loop preload="none" data-src="<%= audio.src %>"></audio>

<!-- WhatsApp RSVP config — read by /js/main.js, never exposed as raw HTML text -->
<script type="application/json" id="waConfig">
<%- JSON.stringify({ number: whatsapp.number, template: whatsapp.messageTemplate }) %>
</script>

<script src="/js/main.js"></script>
</body>
</html>
